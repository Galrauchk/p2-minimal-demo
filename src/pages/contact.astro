---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contacter Valois & Associés — Cabinet d'avocats à Montpellier, Paris et Lyon.">

  <section class="pt-[120px] pb-16" style="border-bottom: 1px solid #f1f5f9;">
    <div class="max-w-[1100px] mx-auto px-8">
      <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-4">07 — Contact</p>
      <h1 class="font-display font-bold text-[clamp(2.75rem,5vw,4.5rem)] text-dark leading-[1.05]"
          style="font-family: 'Playfair Display', Georgia, serif;">
        Parlons de votre projet.
      </h1>
    </div>
  </section>

  <!-- 50/50 split -->
  <section class="py-20">
    <div class="max-w-[1100px] mx-auto px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">

        <!-- Infos -->
        <div class="py-12 pr-0 lg:pr-16" style="border-right: 0; border-bottom: 1px solid #f1f5f9;" data-reveal>
          <h2 class="font-display italic text-[clamp(1.25rem,2vw,1.625rem)] font-normal text-dark leading-[1.3] mb-8"
              style="font-family: 'Playfair Display', Georgia, serif;">
            Un premier échange, sans engagement, pour comprendre votre situation.
          </h2>
          <p class="text-sm font-light text-body leading-[1.9] mb-10 max-w-sm">
            Nos avocats associés répondent personnellement à chaque demande dans un délai de 24 heures ouvrées. Toute consultation initiale est confidentielle.
          </p>

          <div class="space-y-6">
            <div style="border-bottom: 1px solid #f1f5f9;" class="pb-6">
              <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-2">Téléphone</p>
              <a href="tel:+33467112233" class="text-base font-light text-dark hover:text-accent transition-colors">04 67 11 22 33</a>
            </div>
            <div style="border-bottom: 1px solid #f1f5f9;" class="pb-6">
              <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-2">Email</p>
              <a href="mailto:contact@valois-associes.fr" class="text-base font-light text-dark hover:text-accent transition-colors">contact@valois-associes.fr</a>
            </div>
            <div style="border-bottom: 1px solid #f1f5f9;" class="pb-6">
              <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-2">Siège — Montpellier</p>
              <p class="text-sm font-light text-body">12 rue du Palais des Guilhem<br/>34000 Montpellier</p>
            </div>
            <div style="border-bottom: 1px solid #f1f5f9;" class="pb-6">
              <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-2">Bureau Paris</p>
              <p class="text-sm font-light text-body">45 avenue de l'Opéra<br/>75002 Paris</p>
            </div>
            <div>
              <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-2">Bureau Lyon</p>
              <p class="text-sm font-light text-body">8 rue de la République<br/>69002 Lyon</p>
            </div>
          </div>
        </div>

        <!-- Formulaire -->
        <div class="py-12 pl-0 lg:pl-16" data-reveal>
          <form class="space-y-6" novalidate>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Prénom</label>
                <input type="text" name="prenom" autocomplete="given-name"
                  class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors placeholder:text-muted"
                  placeholder="Alexandre" />
              </div>
              <div>
                <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Nom</label>
                <input type="text" name="nom" autocomplete="family-name"
                  class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors placeholder:text-muted"
                  placeholder="Dupont" />
              </div>
            </div>

            <div>
              <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Entreprise</label>
              <input type="text" name="entreprise" autocomplete="organization"
                class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors placeholder:text-muted"
                placeholder="Nom de votre entreprise" />
            </div>

            <div>
              <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Email</label>
              <input type="email" name="email" autocomplete="email"
                class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors placeholder:text-muted"
                placeholder="contact@entreprise.fr" />
            </div>

            <div>
              <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Domaine concerné</label>
              <select name="domaine"
                class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors appearance-none">
                <option value="">Sélectionner...</option>
                <option>Droit des sociétés</option>
                <option>Fusions-acquisitions</option>
                <option>Droit social</option>
                <option>Propriété intellectuelle</option>
                <option>Contentieux</option>
                <option>Autre</option>
              </select>
            </div>

            <div>
              <label class="block text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent mb-2">Votre message</label>
              <textarea name="message" rows="5"
                class="w-full px-0 py-3 text-sm font-light text-dark bg-transparent border-0 border-b border-slate-200 focus:outline-none focus:border-accent transition-colors placeholder:text-muted resize-none"
                placeholder="Décrivez brièvement votre situation..."></textarea>
            </div>

            <div class="pt-2">
              <button type="submit" class="btn-primary w-full justify-center">
                Envoyer la demande
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
              <p class="text-[0.7rem] font-light text-muted mt-4 text-center">
                Réponse sous 24h ouvrées. Toute demande est traitée confidentiellement.
              </p>
            </div>

          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>
