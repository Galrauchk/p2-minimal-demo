---
import Layout from '../layouts/Layout.astro';

const temoignages = [
  {
    quote: "Valois & Associés a géré notre acquisition avec une rigueur et une disponibilité exemplaires. Une équipe qui comprend les enjeux business autant que les enjeux juridiques. Je recommande sans réserve.",
    auteur: "Laurent Fabre",
    titre: "PDG",
    entreprise: "Groupe Fabre Industries, Montpellier",
    domaine: "Fusions-acquisitions",
  },
  {
    quote: "Maître Rousseau nous a accompagnés dans une restructuration sociale délicate avec une maîtrise technique irréprochable et une pédagogie rare. Les salariés comme les managers ont pu traverser cette période difficile avec toutes les cartes en main.",
    auteur: "Sophie Merlin",
    titre: "Directrice des Ressources Humaines",
    entreprise: "Technova Solutions, Lyon",
    domaine: "Droit social",
  },
  {
    quote: "Notre portefeuille de marques était dans un état de gestion approximative depuis des années. En six mois, Maître Maréchal a remis de l'ordre, lancé les dépôts manquants et mis en place un système de surveillance efficace. Un investissement qui s'est révélé précieux.",
    auteur: "Pierre-Emmanuel Doucet",
    titre: "Directeur Général",
    entreprise: "Maison Doucet, Paris",
    domaine: "Propriété intellectuelle",
  },
  {
    quote: "Nous faisions face à un litige contractuel complexe avec un partenaire commercial historique. La stratégie développée par le cabinet nous a permis d'aboutir à un accord amiable, préservant la relation commerciale tout en protégeant pleinement nos intérêts.",
    auteur: "Isabelle Chartier",
    titre: "Co-fondatrice",
    entreprise: "Nexia Medical, Montpellier",
    domaine: "Contentieux",
  },
  {
    quote: "La constitution de notre holding a été traitée avec une précision et une efficacité qui nous ont permis de finaliser notre tour de table dans les délais. Un partenaire de confiance pour toutes nos opérations capitalistiques futures.",
    auteur: "Marc Delacour",
    titre: "Président",
    entreprise: "OpenScale Ventures, Paris",
    domaine: "Droit des sociétés",
  },
];
---

<Layout title="Témoignages" description="Ce que disent nos clients de l'accompagnement de Valois & Associés.">

  <section class="pt-[120px] pb-16" style="border-bottom: 1px solid #f1f5f9;">
    <div class="max-w-[1100px] mx-auto px-8">
      <p class="text-[0.65rem] font-medium tracking-[0.3em] uppercase text-accent mb-4">06 — Témoignages</p>
      <h1 class="font-display font-bold text-[clamp(2.75rem,5vw,4.5rem)] text-dark leading-[1.05]"
          style="font-family: 'Playfair Display', Georgia, serif;">
        Ce que disent nos clients.
      </h1>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[1100px] mx-auto px-8">
      {temoignages.map(({ quote, auteur, titre, entreprise, domaine }, i) => (
        <div class="py-16" style="border-bottom: 1px solid #f1f5f9;" data-reveal>
          <div class="grid grid-cols-1 lg:grid-cols-[65%_35%] gap-16 items-start">
            <blockquote>
              <span class="block font-display font-bold text-[4rem] leading-none mb-0"
                    style="font-family: 'Playfair Display', Georgia, serif; color: #f1f5f9; margin-bottom: -0.5rem;">"</span>
              <p class="font-display italic text-[clamp(1.125rem,1.8vw,1.375rem)] font-normal text-dark leading-[1.6]"
                 style="font-family: 'Playfair Display', Georgia, serif;">
                {quote}
              </p>
            </blockquote>
            <div class="pt-4">
              <p class="font-medium text-sm text-dark">{auteur}</p>
              <p class="text-sm font-light text-muted mt-1">{titre}</p>
              <p class="text-sm font-light text-muted">{entreprise}</p>
              <span class="inline-block mt-4 text-[0.65rem] font-medium tracking-[0.2em] uppercase text-accent px-3 py-1" style="border: 1px solid rgba(0,102,255,0.2);">{domaine}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-[1100px] mx-auto px-8 text-center" data-reveal>
      <h2 class="font-display italic text-[clamp(1.75rem,3vw,2.5rem)] text-dark mb-8"
          style="font-family: 'Playfair Display', Georgia, serif;">
        Rejoignez nos clients satisfaits.
      </h2>
      <a href="/contact" class="btn-primary">Prendre contact →</a>
    </div>
  </section>

</Layout>
