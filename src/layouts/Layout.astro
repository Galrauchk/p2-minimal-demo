---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/700.css';

interface Props {
  title: string;
  description?: string;
  schema?: object;
}

const {
  title,
  description = "Valois & Associés — Cabinet d'avocats d'affaires à Montpellier, Paris et Lyon. Droit des sociétés, fusions-acquisitions, droit social, propriété intellectuelle.",
  schema,
} = Astro.props;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Valois & Associés",
  "description": "Cabinet d'avocats d'affaires à Montpellier, Paris et Lyon.",
  "url": "https://p2-minimal-demo.netlify.app",
  "telephone": "+33467112233",
  "email": "contact@valois-associes.fr",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Montpellier",
    "postalCode": "34000",
    "addressCountry": "FR"
  },
  "priceRange": "€€€"
};

const pageSchemas = Array.isArray(schema) ? schema : (schema ? [schema] : []);
const allSchemas = [localBusinessSchema, ...pageSchemas];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Valois & Associés</title>

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="bg-white text-dark font-sans antialiased overflow-x-hidden">

    <div class="cursor-dot" id="cursorDot"></div>
    <div class="cursor-ring" id="cursorRing"></div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      /* ─── Custom cursor ── */
      const dot  = document.getElementById('cursorDot')!;
      const ring = document.getElementById('cursorRing')!;
      let mx = 0, my = 0, rx = 0, ry = 0;

      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        dot.style.left = mx + 'px';
        dot.style.top  = my + 'px';
      });
      (function loop() {
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        ring.style.left = (rx - 19) + 'px';
        ring.style.top  = (ry - 19) + 'px';
        requestAnimationFrame(loop);
      })();
      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => ring.classList.add('ring-hover'));
        el.addEventListener('mouseleave', () => ring.classList.remove('ring-hover'));
      });

      /* ─── Scroll reveal ── */
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
    </script>

  </body>
</html>
